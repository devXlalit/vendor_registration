# Copy to .env.local. When VITE_API_BASE_URL is unset the app runs in demo/mock
# mode (OTP = 1234, local file previews).

# --- Hato NestJS backend ---
# Base origin only; the client adds the /api/v1 prefix itself.
VITE_API_BASE_URL=http://localhost:3000

# --- Azure Blob Storage (direct browser upload) ---
# Container-level SAS URL (container URL + "?<sas-token>"), granting Create + Write.
# Unset => uploads fall back to local object-URL previews.
VITE_AZURE_BLOB_SAS_URL=https://hatostorage.blob.core.windows.net/vendor-uploads?sv=...&sp=cw&sig=...

# --- Document_Types UUIDs ---
# There is no endpoint to list Document_Types, so provide the ids to enable
# document submission (PUT /users/vendor-documents/:userId). Leave unset to skip.
VITE_HATO_DOCTYPE_PAN=
VITE_HATO_DOCTYPE_GST=
VITE_HATO_DOCTYPE_FSSAI=
